<%@ page pageEncoding="UTF-8" %>
<%-- Popup único (<dialog>) das telas de lista.
     Tem dois formulários: um para Adicionar/Editar e outro para confirmar a remoção.
     Os campos do formulário nascem da configuração "tela" enviada pelo Servlet. --%>
<dialog id="popup" data-singular="<c:out value='${tela.singular}'/>">

    <form id="formSalvar" method="post" action="${ctx}${tela.caminho}" autocomplete="off">
        <h2 id="popupTitulo"></h2>
        <input type="hidden" name="acao" value="salvar">
        <input type="hidden" name="id" value="">

        <c:forEach var="campo" items="${tela.campos}">
            <div class="campo">
                <label for="campo-${campo.nome}"><c:out value="${campo.rotulo}"/></label>
                <c:choose>
                    <c:when test="${campo.tipo eq 'textarea'}">
                        <textarea id="campo-${campo.nome}" name="${campo.nome}" maxlength="${campo.max}" rows="4" required></textarea>
                    </c:when>
                    <c:otherwise>
                        <input id="campo-${campo.nome}" type="${campo.tipo}" name="${campo.nome}" maxlength="${campo.max}" required>
                    </c:otherwise>
                </c:choose>
            </div>
        </c:forEach>

        <div class="acoes-popup">
            <button type="button" class="botao" data-fechar>Cancelar</button>
            <button type="submit" class="botao primario">Salvar</button>
        </div>
    </form>

    <form id="formRemover" method="post" action="${ctx}${tela.caminho}" hidden>
        <h2>Remover</h2>
        <p>Deseja realmente remover o registro selecionado? Esta ação não pode ser desfeita.</p>
        <input type="hidden" name="acao" value="remover">
        <input type="hidden" name="id" value="">
        <div class="acoes-popup">
            <button type="button" class="botao" data-fechar>Cancelar</button>
            <button type="submit" class="botao perigo-solido">Remover</button>
        </div>
    </form>

</dialog>
